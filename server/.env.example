NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
API_BASE_PATH=/api/v1
TRUST_PROXY_HOPS=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=se_admissions
DB_USER=se_admissions_app
DB_PASSWORD=replace-with-a-secret
DB_CONNECTION_LIMIT=8
DB_SSL=false

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=se-admissions-api
JWT_AUDIENCE=se-admissions-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# Mailer configuration (optional in development; uses test/memory transport if omitted)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASSWORD=secret-password
SMTP_FROM=SE Admissions <admissions@example.com>
SMTP_SECURE=false

# Verification services. OCR and archive jobs fail closed when not configured.
GEMINI_API_KEY=
USE_MOCK_OCR=0
USE_MOCK_BOARD=0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
GDRIVE_SERVICE_ACCOUNT_EMAIL=
# Store the private key with literal \n between lines, or escaped newlines.
GDRIVE_PRIVATE_KEY=
GDRIVE_ARCHIVE_FOLDER_ID=
