NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
API_BASE_PATH=/api/v1
TRUST_PROXY_HOPS=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=se_admissions
DB_USER=se_admissions_app
DB_PASSWORD=replace-with-a-secret
DB_CONNECTION_LIMIT=8
DB_SSL=false

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=se-admissions-api
JWT_AUDIENCE=se-admissions-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
